{
  "kind": "ModuleContract",
  "id": "module.test.pipeline_executor",
  "version": "1",
  "ports": {
    "input": {
      "test_pipeline_plan": {
        "artifact_type": "artifact.test_pipeline_plan@1",
        "required": true,
        "description": "Concrete test pipeline plan to execute."
      }
    },
    "output": {
      "test_execution_report": {
        "artifact_type": "artifact.test_execution_report@1",
        "description": "Observed execution report."
      },
      "validation_report": {
        "artifact_type": "artifact.validation_report@1",
        "description": "Pass/fail validation summary."
      },
      "effect_report": {
        "artifact_type": "artifact.effect_report@1",
        "description": "Effects observed while running tests."
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.test.runner",
        "scope": ["scripts/**", "examples/**", "generated/**"]
      }
    ],
    "context": ["workspace_root", "run_id", "external_approval_flags"]
  },
  "effects": {
    "fs_read": ["scripts/**", "examples/**", "generated/**", "schemas/**", "README.md"],
    "fs_write": ["examples/test_results/**", "examples/runtime_runs/**"],
    "network": false,
    "provider_call": false,
    "risk": 1
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "policy_bounded"
  },
  "metadata": {
    "purpose": "Execute the composed test pipeline with local deterministic checks. Live network/provider checks must be represented as separate opt-in modules or runtime flags."
  }
}
