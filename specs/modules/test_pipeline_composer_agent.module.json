{
  "kind": "ModuleContract",
  "id": "module.test.pipeline_composer_agent",
  "version": "1",
  "ports": {
    "input": {
      "goal": {
        "artifact_type": "artifact.goal@1",
        "required": true,
        "description": "Testing target and user intent."
      },
      "environment_plan": {
        "artifact_type": "artifact.test_environment_plan@1",
        "required": true,
        "description": "Candidate test environments."
      },
      "method_plan": {
        "artifact_type": "artifact.test_method_plan@1",
        "required": true,
        "description": "Selected test methods."
      }
    },
    "output": {
      "test_pipeline_plan": {
        "artifact_type": "artifact.test_pipeline_plan@1",
        "description": "Concrete matrix and executable test steps."
      },
      "test_graph": {
        "artifact_type": "artifact.test_graph@1",
        "description": "Graph representation of selected environments, methods, steps, and gates."
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.pipeline.compose",
        "scope": ["test_environments", "test_methods", "quality_gates"]
      }
    ],
    "context": ["workspace_root", "target_project_dir", "optional_local_model_cmd"]
  },
  "effects": {
    "fs_read": ["examples/**", "generated/**", "scripts/**", "README.md"],
    "fs_write": [],
    "network": false,
    "provider_call": false,
    "risk": 1
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "subset_or_equal"
  },
  "metadata": {
    "purpose": "Agent that composes modular test environments and methods into a runnable test pipeline matrix.",
    "composition_rule": "Environment selection and method selection remain separate; this module only binds compatible pairs and emits gates."
  }
}
