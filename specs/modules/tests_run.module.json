{
  "kind": "ModuleContract",
  "id": "module.tests.run",
  "version": "1",
  "ports": {
    "input": {
      "patch_manifest": {
        "artifact_type": "artifact.patch_manifest@1",
        "required": true
      }
    },
    "output": {
      "validation_report": {
        "artifact_type": "artifact.validation_report@1"
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.test.runner",
        "scope": [
          "tests/**"
        ]
      }
    ],
    "context": [
      "run_id",
      "trace_sink"
    ]
  },
  "effects": {
    "fs_read": [
      "project/**",
      "tests/**"
    ],
    "fs_write": [],
    "network": false,
    "provider_call": false,
    "risk": 2
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "subset_or_equal"
  }
}
