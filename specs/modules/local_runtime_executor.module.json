{
  "kind": "ModuleContract",
  "id": "module.local.runtime_executor",
  "version": "1",
  "ports": {
    "input": {
      "pipeline_plan": {
        "artifact_type": "artifact.pipeline_composition_plan@1",
        "required": true,
        "description": "Pipeline plan selected by the local pipeline composer."
      }
    },
    "output": {
      "project_blueprint": {
        "artifact_type": "artifact.project_blueprint@1",
        "description": "Materialized project blueprint."
      },
      "generation_trace": {
        "artifact_type": "artifact.generation_trace@1",
        "description": "Runtime execution trace."
      },
      "test_graph": {
        "artifact_type": "artifact.test_graph@1",
        "description": "Runtime verification graph."
      },
      "effect_report": {
        "artifact_type": "artifact.effect_report@1",
        "description": "Runtime effect and delivery report."
      },
      "runtime_result": {
        "artifact_type": "artifact.runtime_execution_result@1",
        "description": "Executor status, output paths, and external approval decisions."
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.fs.write",
        "scope": ["generated/**", "examples/runtime_runs/**", "examples/test_results/**"]
      }
    ],
    "context": ["run_id", "generation_root", "external_approval_flags"]
  },
  "effects": {
    "fs_read": ["examples/**", "schemas/**"],
    "fs_write": ["generated/**", "examples/runtime_runs/**", "examples/test_results/**"],
    "network": false,
    "provider_call": false,
    "risk": 1
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "policy_bounded"
  },
  "metadata": {
    "purpose": "Local runtime executor that materializes a composed pipeline into project files and runtime artifacts.",
    "external_gate": "Network/provider delivery is disabled by default and requires explicit runtime flags."
  }
}
