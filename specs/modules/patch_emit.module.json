{
  "kind": "ModuleContract",
  "id": "module.patch.emit",
  "version": "1",
  "ports": {
    "input": {
      "plan": {
        "artifact_type": "artifact.implementation_plan@1",
        "required": true
      },
      "snapshot": {
        "artifact_type": "artifact.project_snapshot@1",
        "required": true
      }
    },
    "output": {
      "patch_manifest": {
        "artifact_type": "artifact.patch_manifest@1"
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.fs.read",
        "scope": [
          "project/**"
        ]
      },
      {
        "id": "cap.fs.write",
        "scope": [
          "project/**"
        ]
      }
    ],
    "context": [
      "run_id",
      "trace_sink"
    ]
  },
  "effects": {
    "fs_read": [
      "project/**"
    ],
    "fs_write": [
      "project/**"
    ],
    "network": false,
    "provider_call": false,
    "risk": 2
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "subset_or_equal"
  }
}
