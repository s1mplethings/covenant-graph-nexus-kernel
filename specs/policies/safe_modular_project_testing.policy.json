{
  "kind": "PolicySpec",
  "id": "policy.safe_modular_project_testing",
  "version": "1",
  "fs": {
    "allowed_read": ["scripts/**", "examples/**", "generated/**", "schemas/**", "README.md"],
    "allowed_write": ["examples/test_results/**", "examples/runtime_runs/**"],
    "denied_write": [".git/**", ".env", "secrets/**", "*.pem", "*.key"]
  },
  "network": {
    "allowed": false
  },
  "provider": {
    "allowed": false
  },
  "risk": {
    "max_risk": 1
  },
  "agent_permissions": {
    "allowed_edits": [],
    "denied_edits": ["write_secret", "weaken_policy", "implicit_network", "implicit_provider"],
    "requires_human_review": ["enable_live_connectivity", "enable_provider_review", "send_external_report"]
  }
}
