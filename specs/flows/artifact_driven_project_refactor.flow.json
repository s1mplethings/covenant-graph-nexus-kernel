    {"from":{"node":"n_problem_analysis","port":"analysis"},"to":{"flow_output":"problem_analysis"}},
    {"from":{"node":"n_architecture","port":"architecture"},"to":{"flow_output":"architecture_decision"}},
    {"from":{"node":"n_refactor_plan","port":"plan"},"to":{"flow_output":"refactor_plan"}},
    {"from":{"node":"n_implementation","port":"patch"},"to":{"flow_output":"implementation_patch"}},
