    {"id": "L4", "packages": ["cgkn.executors", "cgkn.runtime"], "description": "bounded execution, coordination and recovery"},
    {"id": "L5", "packages": ["cgkn.agent", "cgkn.growth", "cgkn.governance", "cgkn.telemetry"], "description": "agent, governed growth and telemetry"},
    {"id": "L6", "packages": [], "description": "application and optional team capabilities"}
