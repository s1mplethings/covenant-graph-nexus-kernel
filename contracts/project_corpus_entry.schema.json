{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/s1mplethings/covenant-graph-nexus-kernel/contracts/project_corpus_entry.schema.json",
  "title": "CGNK Project Corpus Entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "corpus_entry_id", "project_family_id",
    "project_attempt_id", "run_id", "created_at", "source_version",
    "generator_version", "task_hash", "status", "provenance", "split",
    "public_project_packet", "snapshot_refs", "metadata", "lineage",
    "events", "tests", "failures", "repairs", "private_evaluator_ref",
    "manifest_hash"
  ],
  "properties": {
    "kind": {"const": "CGNKProjectCorpusEntry"},
    "schema_version": {"const": "1.0"},
    "corpus_entry_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "project_family_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "project_attempt_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "run_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "created_at": {"type": "string"},
    "source_version": {"type": "string"},
    "generator_version": {"type": "string"},
    "task_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["PASS", "FAIL", "PARTIAL", "ABORTED", "BLOCKED_ENVIRONMENT", "BLOCKED_POLICY", "TIMEOUT", "QUARANTINED"]},
    "provenance": {"enum": ["generated_original", "third_party_seeded", "public_repo_derived", "user_supplied", "benchmark_derived", "unknown"]},
    "split": {"enum": ["DEVELOPMENT", "VALIDATION", "FORMAL_HOLDOUT", "QUARANTINE", "PUBLIC_SAMPLE"]},
    "public_project_packet": {"type": "object"},
    "snapshot_refs": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["snapshot_id", "stage", "snapshot_hash"],
        "properties": {
          "snapshot_id": {"type": "string"},
          "stage": {"enum": ["INPUT", "INITIAL_GENERATION", "POST_MATERIALIZATION", "PRE_TEST", "FAILED_TEST", "PRE_REPAIR", "POST_REPAIR", "FINAL", "ABORTED"]},
          "snapshot_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "metadata": {"type": "object"},
    "lineage": {"type": "object"},
    "events": {"type": "array", "items": {"type": "object"}},
    "tests": {"type": "array", "items": {"type": "object"}},
    "failures": {"type": "array", "items": {"type": "object"}},
    "repairs": {"type": "array", "items": {"type": "object"}},
    "private_evaluator_ref": {"type": ["string", "null"]},
    "manifest_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
