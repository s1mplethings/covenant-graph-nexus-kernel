{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgkn.local/contracts/canonical_goal_spec_v2.schema.json",
  "title": "CGKN Canonical GoalSpec",
  "type": "object",
  "required": [
    "kind",
    "schema_version",
    "goal_id",
    "raw_goal",
    "raw_goal_hash",
    "normalized_goal",
    "intended_users",
    "desired_outcomes",
    "core_capabilities",
    "supporting_capabilities",
    "user_workflows",
    "workstreams",
    "explicit_constraints",
    "inferred_constraints",
    "non_goals",
    "open_questions",
    "assumptions",
    "acceptance_anchors",
    "forbidden_substitutions",
    "source_refs",
    "planning_artifact_ref",
    "planning_artifact_hash",
    "provenance_by_field",
    "compiler_version",
    "compiled_at",
    "goal_spec_hash",
    "authority",
    "authority_decision",
    "grounding_validation",
    "status",
    "ready_to_generate"
  ],
  "properties": {
    "kind": {"const": "GoalSpec"},
    "schema_version": {"const": "2.0"},
    "goal_id": {"type": "string", "minLength": 1},
    "raw_goal": {"type": "string", "minLength": 1},
    "raw_goal_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "normalized_goal": {"type": "string", "minLength": 1},
    "intended_users": {"$ref": "#/$defs/strings"},
    "desired_outcomes": {"$ref": "#/$defs/strings"},
    "core_capabilities": {"$ref": "#/$defs/strings"},
    "supporting_capabilities": {"$ref": "#/$defs/strings"},
    "user_workflows": {"$ref": "#/$defs/strings"},
    "workstreams": {"type": "array", "items": {"type": "object"}},
    "explicit_constraints": {"$ref": "#/$defs/strings"},
    "inferred_constraints": {"$ref": "#/$defs/strings"},
    "non_goals": {"$ref": "#/$defs/strings"},
    "open_questions": {"$ref": "#/$defs/strings"},
    "assumptions": {"$ref": "#/$defs/strings"},
    "acceptance_anchors": {"$ref": "#/$defs/strings"},
    "forbidden_substitutions": {"$ref": "#/$defs/strings"},
    "source_refs": {"type": "array", "items": {"type": "object"}},
    "planning_artifact_ref": {"type": "string"},
    "planning_artifact_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "provenance_by_field": {"type": "object"},
    "compiler_version": {"type": "string", "minLength": 1},
    "compiled_at": {"type": "string", "minLength": 1},
    "goal_spec_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "authority": {"const": "canonical_requirement_authority"},
    "authority_decision": {"enum": ["PASS", "NEEDS_REWORK"]},
    "grounding_validation": {"type": "object"},
    "status": {"enum": ["PASS", "NEEDS_REWORK"]},
    "ready_to_generate": {"type": "boolean"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}}
  }
}
