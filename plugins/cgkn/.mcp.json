{
  "mcpServers": {
    "cgkn": {
      "command": "D:\\anaconda\\python.exe",
      "args": [
        "./scripts/cgkn_mcp_server.py",
        "--cgkn-root",
        "D:\\CGKN"
      ],
      "cwd": ".",
      "enabled": true,
      "env_vars": [
        "CGKN_ROOT",
        "CGKN_OPENAI_API_KEY",
        "CGKN_OPENAI_BASE_URL",
        "PATH",
        "TEMP",
        "TMP",
        "USERPROFILE",
        "LOCALAPPDATA"
      ],
      "startup_timeout_sec": 20,
      "tool_timeout_sec": 3600
    }
  }
}
