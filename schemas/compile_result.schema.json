{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/compile_result.schema.json",
  "title": "CompileResult",
  "type": "object",
  "required": [
    "kind",
    "ok",
    "flow_ref",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "CompileResult"
    },
    "ok": {
      "type": "boolean"
    },
    "flow_ref": {
      "$ref": "common_defs.schema.json#/$defs/flow_ref"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      }
    },
    "compiled_bundle": {
      "type": "object"
    },
    "statistics": {
      "type": "object"
    }
  }
}
