{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/compile_result.schema.json",
  "title": "CompileResult",
  "type": "object",
  "required": [
    "kind",
    "ok",
    "flow_ref",
    "diagnostics"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "CompileResult"
    },
    "ok": {
      "type": "boolean"
    },
    "flow_ref": {
      "$ref": "common_defs.schema.json#/$defs/flow_ref"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      }
    },
    "compiled_bundle": {
      "type": [
        "object",
        "null"
      ]
    },
    "schema_version": {
      "type": "string"
    },
    "policy_ref": {
      "$ref": "common_defs.schema.json#/$defs/policy_ref"
    },
    "normalized_bundle": {
      "type": [
        "object",
        "null"
      ]
    },
    "compiled_flow": {
      "type": [
        "object",
        "null"
      ]
    },
    "symbol_table": {
      "type": "object"
    },
    "resolved_nodes": {
      "type": "array"
    },
    "resolved_edges": {
      "type": "array"
    },
    "resolved_artifacts": {
      "type": "array",
      "items": {
        "$ref": "common_defs.schema.json#/$defs/artifact_ref"
      }
    },
    "required_inputs": {
      "type": "object"
    },
    "produced_outputs": {
      "type": "object"
    },
    "effect_summary": {
      "type": "object"
    },
    "capability_summary": {
      "type": "array"
    },
    "gates": {
      "type": "array"
    },
    "compiled_contract_bundle": {
      "type": [
        "object",
        "null"
      ]
    },
    "contract_pack": {
      "type": [
        "object",
        "null"
      ]
    },
    "statistics": {
      "type": "object"
    }
  }
}
