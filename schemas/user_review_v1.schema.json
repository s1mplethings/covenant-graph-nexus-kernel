{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN User Review Evidence v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "review_required",
    "review_request_id",
    "review_request_ref",
    "review_request_hash",
    "review_event_id",
    "reviewer",
    "channel",
    "chat_id",
    "telegram_update_id",
    "telegram_message_id",
    "telegram_message_date",
    "reviewed_candidate_hash",
    "reviewed_evidence",
    "reviewed_evidence_hashes",
    "review_request_created_at",
    "review_request_presented_at",
    "reviewed_at",
    "approval_text_hash",
    "decision"
  ],
  "properties": {
    "kind": { "const": "CGKNUserReviewEvidence" },
    "review_required": { "type": "boolean" },
    "review_request_id": { "type": "string", "minLength": 1 },
    "review_request_ref": { "type": "string", "minLength": 1 },
    "review_request_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "review_event_id": { "type": "string" },
    "reviewer": { "type": "string", "minLength": 1 },
    "channel": { "const": "telegram" },
    "chat_id": { "type": "string", "minLength": 1 },
    "telegram_update_id": { "type": "string", "minLength": 1 },
    "telegram_message_id": { "type": "string", "minLength": 1 },
    "telegram_message_date": { "type": "string", "minLength": 1 },
    "reviewed_candidate_hash": { "type": "string" },
    "reviewed_evidence_hashes": { "type": "array", "items": { "type": "string" } },
    "reviewed_evidence": { "type": "array", "items": { "type": "object" } },
    "review_request_created_at": { "type": "string", "minLength": 1 },
    "review_request_presented_at": { "type": "string", "minLength": 1 },
    "reviewed_at": { "type": "string" },
    "approval_text_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "decision": { "const": "APPROVED" }
  },
  "additionalProperties": true
}
