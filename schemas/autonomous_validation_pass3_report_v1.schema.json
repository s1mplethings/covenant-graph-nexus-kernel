{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgkn.local/schemas/autonomous_validation_pass3_report_v1.schema.json",
  "title": "CGKN Autonomous Validation Pass 3 Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "run_id", "created_at", "formal_evidence_status",
    "release_authority", "base_commit", "source_identities", "scenario_plan_ref",
    "model", "fairness_audit", "adjustment_audit", "group_results",
    "d_only_finding_keys", "answers", "recommendation", "model_call_receipts",
    "known_limits", "report_sha256"
  ],
  "properties": {
    "kind": {"const": "CGKNAutonomousValidationPass3Report"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "formal_evidence_status": {"const": "NOT_EVALUATED"},
    "release_authority": {"const": false},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_identities": {"type": "object", "minProperties": 2},
    "scenario_plan_ref": {"type": "string", "minLength": 1},
    "model": {
      "type": "object",
      "required": ["name", "real_provider_calls", "provider_host", "pricing"],
      "properties": {"real_provider_calls": {"const": true}}
    },
    "fairness_audit": {
      "type": "object",
      "required": ["status", "same_project_version", "same_public_materials", "same_execution_permissions", "same_maximum_operation_budget", "same_independent_oracles"],
      "properties": {"status": {"const": "PASS"}}
    },
    "adjustment_audit": {
      "type": "object",
      "required": ["projects", "all_projects_adjusted"]
    },
    "group_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "C", "D"],
      "properties": {
        "A": {"$ref": "#/$defs/group"},
        "C": {"$ref": "#/$defs/group"},
        "D": {"$ref": "#/$defs/group"}
      }
    },
    "d_only_finding_keys": {"type": "array", "items": {"type": "string"}},
    "answers": {"type": "object", "required": ["d_finds_c_misses", "d_adjusted_from_feedback", "new_business_meaning", "model_cost_worth_it", "reusable_capabilities", "gui_only_gaps", "d_vs_a"]},
    "recommendation": {"type": "string", "minLength": 1},
    "model_call_receipts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/model_call"}},
    "known_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "group", "findings", "candidate_findings", "valid_findings",
        "false_positive_rate", "reproduction_success_rate", "actions_executed",
        "maximum_actions", "execution_wall_time_seconds", "issue_types",
        "rejected_model_actions",
        "model_calls", "input_tokens", "output_tokens", "total_tokens",
        "estimated_cost_usd", "pricing_complete", "model_wall_time_seconds"
        , "estimated_total_wall_time_seconds"
      ]
    },
    "model_call": {
      "type": "object",
      "required": ["project_id", "group", "round", "model", "provider_host", "request_sha256", "response_sha256", "input_tokens", "output_tokens", "total_tokens", "estimated_cost_usd", "duration_seconds"]
    }
  }
}
