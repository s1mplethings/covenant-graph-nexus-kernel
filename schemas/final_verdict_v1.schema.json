{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN Final Verdict v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "required_gates",
    "upstream_gates",
    "overall_status"
  ],
  "properties": {
    "kind": { "const": "CGKNFinalVerdict" },
    "required_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "upstream_gates": { "type": "object" },
    "overall_status": { "$ref": "canonical_defs.schema.json#/$defs/EvidenceStatus" }
  },
  "additionalProperties": true
}
