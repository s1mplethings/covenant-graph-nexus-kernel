{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/project_knowledge_manifest_v2.schema.json",
  "title": "ProjectKnowledgePersistenceManifestV2",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "format_version", "pack_id", "generation", "schema_version", "first_sequence", "latest_sequence", "authoritative_segments", "current_checkpoint", "checkpoint_covered_sequence", "authority_root_hash", "segment_policy_version", "compaction_policy_version", "created_at", "updated_at", "manifest_checksum"],
  "properties": {
    "kind": {"const": "ProjectKnowledgePersistenceManifest"},
    "format_version": {"const": "2.0"},
    "pack_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$"},
    "generation": {"type": "integer", "minimum": 1},
    "schema_version": {"type": "string", "minLength": 1},
    "first_sequence": {"const": 1},
    "latest_sequence": {"type": "integer", "minimum": 1},
    "authoritative_segments": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/segmentDescriptor"}},
    "current_checkpoint": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpointDescriptor"}]},
    "checkpoint_covered_sequence": {"type": "integer", "minimum": 0},
    "authority_root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "segment_policy_version": {"type": "string"},
    "compaction_policy_version": {"type": "string"},
    "created_at": {"type": "string"},
    "updated_at": {"type": "string"},
    "manifest_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "$defs": {
    "segmentDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "path", "sequence_start", "sequence_end", "record_count", "previous_authority_root_hash", "authority_root_hash", "content_checksum", "file_hash", "file_bytes"],
      "properties": {
        "segment_id": {"type": "string"},
        "path": {"type": "string", "pattern": "^segments/seg-[0-9]{20}-[0-9]{20}-[0-9a-f]{16}\\.json$"},
        "sequence_start": {"type": "integer", "minimum": 1},
        "sequence_end": {"type": "integer", "minimum": 1},
        "record_count": {"type": "integer", "minimum": 1},
        "previous_authority_root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority_root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "content_checksum": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "file_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "file_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "checkpointDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_id", "path", "covered_sequence", "authority_root_hash", "logical_state_hash", "index_hash", "file_hash", "file_bytes"],
      "properties": {
        "checkpoint_id": {"type": "string"},
        "path": {"type": "string", "pattern": "^checkpoints/checkpoint-[0-9]{20}-[0-9a-f]{16}\\.json$"},
        "covered_sequence": {"type": "integer", "minimum": 1},
        "authority_root_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "logical_state_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "index_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "file_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "file_bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
