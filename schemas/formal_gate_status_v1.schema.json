{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN Formal Gate Status v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "gate",
    "scope",
    "source_ref",
    "source_hash",
    "source_producer",
    "inspector",
    "inspector_result",
    "failures",
    "blocker_code"
  ],
  "properties": {
    "kind": { "const": "CGKNFormalGateStatus" },
    "gate": { "type": "string", "minLength": 1 },
    "scope": { "enum": ["candidate", "repository"] },
    "source_ref": { "type": "string" },
    "source_hash": {
      "oneOf": [
        { "const": "" },
        { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      ]
    },
    "source_producer": { "type": "string" },
    "inspector": { "type": "string" },
    "inspector_result": { "type": "object" },
    "failures": { "type": "array", "items": { "type": "string" } },
    "blocker_code": { "type": "string" }
  },
  "additionalProperties": true
}
