{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN Production Candidate Provenance v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "production_entrypoint",
    "generation_function",
    "candidate_root",
    "production_run_root",
    "candidate_source_manifest",
    "candidate_source_manifest_hash",
    "candidate_hash_method",
    "stage_receipts",
    "artifact_refs"
  ],
  "properties": {
    "kind": { "const": "CGKNProductionCandidateProvenance" },
    "schema_version": { "const": "1.0" },
    "producer": { "const": "scripts/telegram_live_bridge.py" },
    "status": { "const": "PASS" },
    "production_entrypoint": {
      "const": "scripts.telegram_live_bridge.start_generation_from_income"
    },
    "generation_function": {
      "const": "scripts.telegram_live_bridge.run_provider_generation_job"
    },
    "candidate_root": { "type": "string", "minLength": 1 },
    "production_run_root": { "type": "string", "minLength": 1 },
    "candidate_source_manifest": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^sha256:[0-9a-f]{64}$"
      }
    },
    "candidate_source_manifest_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_hash_method": {
      "const": "scripts.canonical_evidence_hash.candidate_source_hash"
    },
    "stage_receipts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["stage", "ref", "hash"],
        "properties": {
          "stage": {
            "enum": [
              "production_entry",
              "provider_generation",
              "provider_validation",
              "post_build"
            ]
          },
          "ref": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "artifact_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role", "ref", "hash"],
        "properties": {
          "role": { "type": "string", "minLength": 1 },
          "ref": { "type": "string", "minLength": 1 },
          "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
