{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/ctcp_feature_map.schema.json",
  "title": "CTCPFeatureMapSpec",
  "type": "object",
  "required": [
    "kind",
    "id",
    "version",
    "features"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "CTCPFeatureMapSpec"
    },
    "id": {
      "type": "string",
      "pattern": "^ctcp_feature_map\\.[a-z0-9_.-]+$"
    },
    "version": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "legacy",
          "target",
          "migration",
          "preserve"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^feature\\.[a-z0-9_.-]+$"
          },
          "status": {
            "enum": [
              "unmapped",
              "mapped",
              "proof_ready",
              "migrated"
            ]
          },
          "legacy": {
            "type": "object",
            "required": [
              "files",
              "entrypoints"
            ],
            "additionalProperties": false,
            "properties": {
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "entrypoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "target": {
            "type": "object",
            "required": [
              "flow",
              "modules",
              "artifacts"
            ],
            "additionalProperties": false,
            "properties": {
              "flow": {
                "$ref": "common_defs.schema.json#/$defs/flow_ref"
              },
              "modules": {
                "type": "array",
                "items": {
                  "$ref": "common_defs.schema.json#/$defs/module_ref"
                }
              },
              "artifacts": {
                "type": "array",
                "items": {
                  "$ref": "common_defs.schema.json#/$defs/artifact_ref"
                }
              }
            }
          },
          "migration": {
            "type": "string",
            "pattern": "^migration\\.[a-z0-9_.-]+@[0-9]+$"
          },
          "preserve": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
