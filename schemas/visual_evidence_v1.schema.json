{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN Visual Evidence v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "customer_runtime_ref",
    "customer_runtime_hash",
    "browser",
    "url",
    "actions",
    "dom_assertions",
    "network_requests",
    "screenshot_path",
    "screenshot_hash",
    "viewport",
    "formal_evidence"
  ],
  "properties": {
    "kind": { "const": "CGKNVisualEvidence" },
    "customer_runtime_ref": { "type": "string", "minLength": 1 },
    "customer_runtime_hash": { "type": "string", "minLength": 1 },
    "browser": { "type": "object", "required": ["engine", "version"], "additionalProperties": true },
    "url": { "type": "string", "minLength": 1 },
    "actions": { "type": "array", "minItems": 1 },
    "dom_assertions": { "type": "array", "minItems": 1 },
    "network_requests": { "type": "array" },
    "screenshot_path": { "type": "string", "minLength": 1 },
    "screenshot_hash": { "type": "string", "minLength": 1 },
    "viewport": { "type": "object" },
    "formal_evidence": { "const": true }
  },
  "additionalProperties": true
}
