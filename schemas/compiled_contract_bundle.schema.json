{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/compiled_contract_bundle.schema.json",
  "title": "CompiledContractBundle",
  "type": "object",
  "required": [
    "kind",
    "flow_ref",
    "policy_ref",
    "symbols",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "CompiledContractBundle"
    },
    "flow_ref": {
      "$ref": "common_defs.schema.json#/$defs/flow_ref"
    },
    "policy_ref": {
      "$ref": "common_defs.schema.json#/$defs/policy_ref"
    },
    "symbols": {
      "type": "object"
    },
    "checks": {
      "type": "object"
    },
    "normalized_bundle": {
      "type": "object"
    },
    "compiled_flow": {
      "type": "object"
    },
    "symbol_table": {
      "type": "object"
    },
    "hashes": {
      "type": "object"
    },
    "surface_hash": {
      "type": "string"
    },
    "policy_hash": {
      "type": "string"
    },
    "graph_hash": {
      "type": "string"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      }
    },
    "normalized_flow": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
