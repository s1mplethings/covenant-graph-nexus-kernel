{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/compiled_contract_bundle.schema.json",
  "title": "CompiledContractBundle",
  "type": "object",
  "required": [
    "kind",
    "flow_ref",
    "policy_ref",
    "symbols",
    "checks"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "CompiledContractBundle"
    },
    "flow_ref": {
      "$ref": "common_defs.schema.json#/$defs/flow_ref"
    },
    "policy_ref": {
      "$ref": "common_defs.schema.json#/$defs/policy_ref"
    },
    "symbols": {
      "type": "object"
    },
    "checks": {
      "type": "object"
    },
    "normalized_flow": {
      "type": "object"
    },
    "metadata": {
      "type": "object"
    }
  }
}
