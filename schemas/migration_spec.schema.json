{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/migration_spec.schema.json",
  "title": "MigrationSpec",
  "type": "object",
  "required": [
    "kind",
    "id",
    "version",
    "legacy",
    "target",
    "preserve",
    "proof"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "MigrationSpec"
    },
    "id": {
      "type": "string",
      "pattern": "^migration\\.[a-z0-9_.-]+$"
    },
    "version": {
      "type": "string"
    },
    "legacy": {
      "type": "object",
      "required": [
        "files",
        "public_entrypoints"
      ],
      "additionalProperties": true,
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "public_entrypoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "protected_outputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "target": {
      "type": "object",
      "required": [
        "flow",
        "modules"
      ],
      "additionalProperties": true,
      "properties": {
        "flow": {
          "$ref": "common_defs.schema.json#/$defs/flow_ref"
        },
        "modules": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/module_ref"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "common_defs.schema.json#/$defs/artifact_ref"
          }
        }
      }
    },
    "preserve": {
      "type": "object"
    },
    "allowed_changes": {
      "type": "object"
    },
    "denied_changes": {
      "type": "object"
    },
    "proof": {
      "type": "object",
      "required": [
        "required_tests",
        "required_artifacts"
      ],
      "additionalProperties": true,
      "properties": {
        "required_tests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_schemas": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required_diagnostics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
