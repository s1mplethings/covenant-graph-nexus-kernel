{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN Delivery Receipt v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "required_attachment_kinds",
    "sent_attachment_kinds",
    "telegram_receipts",
    "file_hashes",
    "failed_attachment_kinds",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "kind": { "const": "CGKNDeliveryReceipt" },
    "required_attachment_kinds": { "type": "array", "items": { "type": "string" } },
    "sent_attachment_kinds": { "type": "array", "items": { "type": "string" } },
    "telegram_receipts": { "type": "array" },
    "file_hashes": { "type": "object" },
    "failed_attachment_kinds": { "type": "array", "items": { "type": "string" } },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
