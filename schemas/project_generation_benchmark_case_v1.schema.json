{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgkn.local/schemas/project_generation_benchmark_case_v1.schema.json",
  "title": "CGKN Project Generation Benchmark v1 Case Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "benchmark_id", "cases"],
  "properties": {
    "kind": {"const": "CGKNProjectGenerationBenchmarkCaseCatalog"},
    "schema_version": {"const": "1.0.0"},
    "benchmark_id": {"const": "CGKN_PROJECT_GENERATION_BENCHMARK_V1"},
    "cases": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/case"}
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description"],
      "properties": {
        "id": {"type": "string", "minLength": 2},
        "description": {"type": "string", "minLength": 4}
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "category", "description", "hard", "requirement_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 3},
        "category": {
          "enum": ["functional", "runtime", "persistence", "integration", "repair", "delivery", "efficiency"]
        },
        "description": {"type": "string", "minLength": 4},
        "hard": {"type": "boolean"},
        "requirement_ids": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "case_id", "level", "title", "user_goal", "allowed_assumptions", "hard_requirements",
        "hidden_acceptance", "runtime_requirements", "visual_requirements", "delivery_requirements"
      ],
      "properties": {
        "case_id": {"pattern": "^CASE_(0[1-9]|10)_[A-Z0-9_]+$", "type": "string"},
        "level": {"enum": ["L1", "L2", "L3", "L4", "L5"]},
        "title": {"type": "string", "minLength": 4},
        "user_goal": {"type": "string", "minLength": 10},
        "allowed_assumptions": {"type": "array", "items": {"type": "string"}},
        "hard_requirements": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/requirement"}},
        "hidden_acceptance": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/criterion"}},
        "runtime_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "visual_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "delivery_requirements": {"type": "array", "minItems": 1, "items": {"type": "string"}}
      }
    }
  }
}
