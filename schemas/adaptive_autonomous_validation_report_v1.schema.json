{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgkn.local/schemas/adaptive_autonomous_validation_report_v1.schema.json",
  "title": "CGKN Adaptive Autonomous Validation Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "run_id", "created_at", "formal_evidence_status",
    "release_authority", "base_commit", "source_identities", "scenario_plan_ref",
    "model", "budget_comparison", "budget_inequality_notice", "group_results", "strategy_contributions",
    "acceptance_audit", "conditional_escalation_default_enabled", "recommendation",
    "model_call_receipts", "known_limits", "report_sha256"
  ],
  "properties": {
    "kind": {"const": "CGKNAdaptiveAutonomousValidationReport"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "formal_evidence_status": {"const": "NOT_EVALUATED"},
    "release_authority": {"const": false},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_identities": {"type": "object", "minProperties": 3},
    "scenario_plan_ref": {"type": "string", "minLength": 1},
    "model": {"type": "object", "required": ["name", "model_neutral_openai_compatible_client", "local_model_compatible", "pricing"]},
    "budget_comparison": {"type": "object", "required": ["A", "B", "C", "D"]},
    "budget_inequality_notice": {"type": "string", "minLength": 1},
    "group_results": {
      "type": "object", "additionalProperties": false, "required": ["A", "B", "C", "D"],
      "properties": {"A": {"$ref": "#/$defs/group"}, "B": {"$ref": "#/$defs/group"}, "C": {"$ref": "#/$defs/group"}, "D": {"$ref": "#/$defs/group"}}
    },
    "strategy_contributions": {
      "type": "object",
      "required": ["deterministic_only_vs_one_shot_semantic", "one_shot_semantic_only_vs_deterministic", "combined_observed_union", "conditional_escalation_only"]
    },
    "acceptance_audit": {
      "type": "object",
      "required": ["combined_preserves_unique_findings", "operation_contract", "normal_case_no_unnecessary_escalation", "independent_reproduction", "compression", "new_project"]
    },
    "conditional_escalation_default_enabled": {"type": "boolean"},
    "recommendation": {"type": "string", "minLength": 1},
    "model_call_receipts": {"type": "array", "items": {"type": "object"}},
    "known_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "group", "findings", "candidate_findings", "valid_findings", "unique_finding_keys",
        "issue_types", "false_positive_rate", "reproduction_success_rate", "discovery_actions",
        "actual_execution_actions", "replay_overhead_actions", "model_calls", "input_tokens",
        "output_tokens", "total_tokens", "estimated_cost_usd", "execution_wall_time_seconds",
        "model_wall_time_seconds", "invalid_proposals", "invalid_executions", "escalations",
        "unnecessary_escalations", "unnecessary_escalation_ratio", "nonproductive_escalations",
        "nonproductive_escalation_ratio", "escalation_only_issue_types"
      ]
    }
  }
}
