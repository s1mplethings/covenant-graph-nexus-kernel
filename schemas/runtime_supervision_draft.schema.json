{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime_supervision_draft.schema.json",
  "title": "CGKN Runtime Supervision Draft",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "scope",
    "summary",
    "diagnosis",
    "evidence_refs",
    "guidance",
    "repair_targets",
    "acceptance_checks",
    "known_limits"
  ],
  "properties": {
    "action": {
      "enum": [
        "rework_project",
        "recheck_evidence",
        "repair_kernel",
        "user_decision",
        "resume",
        "halt"
      ]
    },
    "scope": {
      "enum": ["none", "project", "integration", "requirements", "evidence", "runtime", "visual", "identity", "kernel", "user", "safety"]
    },
    "summary": {"type": "string", "minLength": 1, "maxLength": 1600},
    "diagnosis": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 800}
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "ref", "sha256", "claim"],
        "properties": {
          "role": {"type": "string", "maxLength": 80},
          "ref": {"type": "string", "minLength": 1, "maxLength": 600},
          "sha256": {"type": "string", "maxLength": 64},
          "claim": {"type": "string", "maxLength": 400}
        }
      }
    },
    "guidance": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 800}
    },
    "repair_targets": {
      "type": "array",
      "maxItems": 12,
      "items": {"type": "string", "maxLength": 400}
    },
    "acceptance_checks": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 800}
    },
    "known_limits": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "maxLength": 800}
    }
  }
}
