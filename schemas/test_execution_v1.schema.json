{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN Test Execution Evidence v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "candidate_id",
    "candidate_hash",
    "commit_sha",
    "producer",
    "created_at",
    "status",
    "artifact_hash",
    "argv",
    "cwd",
    "environment",
    "started_at",
    "finished_at",
    "exit_code",
    "timeout",
    "collected",
    "passed",
    "failed",
    "skipped",
    "skip_reasons",
    "stdout_artifact",
    "stdout_hash",
    "stderr_artifact",
    "stderr_hash",
    "result_artifact_hash",
    "test_profile"
  ],
  "properties": {
    "kind": { "const": "CGKNTestExecutionEvidence" },
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "cwd": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "started_at": { "type": "string", "minLength": 1 },
    "finished_at": { "type": "string", "minLength": 1 },
    "exit_code": { "type": "integer" },
    "timeout": { "type": "boolean" },
    "collected": { "type": "integer", "minimum": 0 },
    "passed": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "skipped": { "type": "integer", "minimum": 0 },
    "skip_reasons": { "type": "object" },
    "stdout_artifact": { "type": "string", "minLength": 1 },
    "stdout_hash": { "type": "string", "minLength": 1 },
    "stderr_artifact": { "type": "string", "minLength": 1 },
    "stderr_hash": { "type": "string", "minLength": 1 },
    "result_artifact_hash": { "type": "string", "minLength": 1 },
    "test_profile": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
