{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgkn.local/schemas/role_driven_validation_report_v1.schema.json",
  "title": "CGKN Role-Driven Validation Support Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "schema_version",
    "run_id",
    "created_at",
    "formal_evidence_status",
    "release_authority",
    "project_understanding",
    "source_identity",
    "adapter",
    "roles",
    "scenario_plan_ref",
    "arms",
    "comparison",
    "known_limits",
    "report_sha256"
  ],
  "properties": {
    "kind": {"const": "CGKNRoleDrivenValidationSupportReport"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "formal_evidence_status": {"const": "NOT_EVALUATED"},
    "release_authority": {"const": false},
    "project_understanding": {"type": "object"},
    "source_identity": {
      "type": "object",
      "required": ["repository_root", "project_relative_path", "commit_sha", "project_public_tree_sha256", "target_path_clean"]
    },
    "adapter": {"type": "string", "minLength": 1},
    "roles": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["role_id", "name", "goal", "evidence_refs"]
      }
    },
    "scenario_plan_ref": {"type": "string", "minLength": 1},
    "arms": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline", "role_driven"],
      "properties": {
        "baseline": {"$ref": "#/$defs/arm"},
        "role_driven": {"$ref": "#/$defs/arm"}
      }
    },
    "comparison": {
      "type": "object",
      "required": ["same_model", "same_model_budget", "same_scenario_budget", "same_project_version", "additional_valid_defects", "conclusion"]
    },
    "known_limits": {"type": "array", "items": {"type": "string"}},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "arm": {
      "type": "object",
      "required": ["arm", "source_identity", "isolation", "budget", "scenario_results", "issues", "metrics", "operation_log", "formal_evidence_status"],
      "properties": {
        "arm": {"type": "string"},
        "source_identity": {"type": "object"},
        "isolation": {"type": "object"},
        "budget": {"type": "object"},
        "scenario_results": {"type": "array"},
        "issues": {"type": "array"},
        "metrics": {"type": "object"},
        "operation_log": {"type": "string"},
        "formal_evidence_status": {"const": "NOT_EVALUATED"}
      }
    }
  }
}
