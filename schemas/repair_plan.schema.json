{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/repair_plan.schema.json",
  "title": "RepairPlan",
  "type": "object",
  "required": [
    "kind",
    "version",
    "target_proposal",
    "target_flow",
    "original_proposal",
    "source_diagnostics",
    "suggested_edits",
    "confidence",
    "requires_recompile",
    "blocked_reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "kind": {
      "const": "RepairPlan"
    },
    "version": {
      "type": "string"
    },
    "target_proposal": {
      "type": "string",
      "pattern": "^proposal\\.[a-z0-9_.-]+@[0-9]+$"
    },
    "target_flow": {
      "$ref": "common_defs.schema.json#/$defs/flow_ref"
    },
    "original_proposal": {
      "type": "object"
    },
    "source_diagnostics": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      }
    },
    "suggested_edits": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "confidence": {
      "enum": [
        "deterministic",
        "heuristic",
        "none"
      ]
    },
    "requires_recompile": {
      "const": true
    },
    "blocked_reasons": {
      "type": "array",
      "items": {
        "$ref": "diagnostic.schema.json"
      }
    }
  }
}
