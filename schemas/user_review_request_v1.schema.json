{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CGKN User Review Request v1",
  "allOf": [{ "$ref": "canonical_defs.schema.json#/$defs/ArtifactEnvelope" }],
  "required": [
    "kind", "schema_version", "run_id", "candidate_id", "candidate_hash", "commit_sha",
    "producer", "created_at", "status", "artifact_hash", "review_request_id", "project_dir",
    "conversation_id", "expected_reviewer_id", "replay_ledger_ref", "reviewed_evidence", "reviewed_evidence_hashes", "visual_required",
    "required_presentation_roles", "presented_artifacts", "requirement_snapshot", "requested_at",
    "presented_at", "presentation_succeeded"
  ],
  "properties": {
    "kind": { "const": "CGKNUserReviewRequest" },
    "review_request_id": { "type": "string", "minLength": 1 },
    "project_dir": { "type": "string", "minLength": 1 },
    "conversation_id": { "type": "string", "minLength": 1 },
    "expected_reviewer_id": { "type": "string", "minLength": 1 },
    "replay_ledger_ref": { "type": "string", "minLength": 1 },
    "reviewed_evidence": { "type": "array", "minItems": 2, "items": { "type": "object" } },
    "reviewed_evidence_hashes": { "type": "array", "minItems": 2, "items": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } },
    "visual_required": { "type": "boolean" },
    "required_presentation_roles": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "presented_artifacts": { "type": "array", "items": { "type": "object" } },
    "requested_at": { "type": "string", "minLength": 1 },
    "presented_at": { "type": "string" },
    "presentation_succeeded": { "type": "boolean" }
  },
  "additionalProperties": true
}
