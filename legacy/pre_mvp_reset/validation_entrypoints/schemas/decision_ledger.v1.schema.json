{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgnk.local/schemas/decision_ledger.v1.schema.json",
  "title": "DecisionLedgerPayload",
  "type": "object",
  "required": ["kind", "run_id", "updated_at", "decisions"],
  "additionalProperties": false,
  "properties": {
    "kind": {"const": "DecisionLedger"},
    "run_id": {"type": "string"},
    "updated_at": {"type": "string"},
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "stage", "decision", "rationale", "created_at"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string"},
          "stage": {"type": "string"},
          "decision": {"type": "string"},
          "rationale": {"type": "string"},
          "alternatives": {"type": "array", "items": {"type": "string"}},
          "created_at": {"type": "string"},
          "artifact_refs": {"type": "object", "additionalProperties": {"type": "string"}},
          "inputArtifactRefs": {"type": "array", "items": {"$ref": "artifact_ref.v1.schema.json"}},
          "outputArtifactRefs": {"type": "array", "items": {"$ref": "artifact_ref.v1.schema.json"}}
        }
      }
    }
  }
}
