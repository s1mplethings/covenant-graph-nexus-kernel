{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cgkn.local/schemas/role_driven_validation_pass2_report_v1.schema.json",
  "title": "CGKN Role-Driven Validation Cross-Project Research Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind", "schema_version", "run_id", "created_at", "formal_evidence_status",
    "release_authority", "base_commit", "deterministic_test", "llm_used",
    "pass1_review", "public_plan_ref", "hidden_baseline_ref", "fairness_audit",
    "blindness_audit", "project_results", "group_results", "answers",
    "recommendation", "known_limits", "report_sha256"
  ],
  "properties": {
    "kind": {"const": "CGKNRoleDrivenValidationCrossProjectReport"},
    "schema_version": {"const": "1.0"},
    "run_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "formal_evidence_status": {"const": "NOT_EVALUATED"},
    "release_authority": {"const": false},
    "base_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "deterministic_test": {"const": true},
    "llm_used": {"const": false},
    "pass1_review": {"type": "object"},
    "public_plan_ref": {"type": "string", "minLength": 1},
    "hidden_baseline_ref": {"type": "string", "minLength": 1},
    "fairness_audit": {"$ref": "#/$defs/audit"},
    "blindness_audit": {"$ref": "#/$defs/audit"},
    "project_results": {"type": "array", "minItems": 3, "items": {"type": "object"}},
    "group_results": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C"],
      "properties": {
        "A": {"$ref": "#/$defs/group"},
        "B": {"$ref": "#/$defs/group"},
        "C": {"$ref": "#/$defs/group"}
      }
    },
    "answers": {"type": "object"},
    "recommendation": {"type": "string", "minLength": 1},
    "known_limits": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "audit": {
      "type": "object",
      "required": ["status"],
      "properties": {"status": {"const": "PASS"}}
    },
    "group": {
      "type": "object",
      "required": [
        "group", "known_defects", "candidate_findings", "valid_defects",
        "defect_recall", "false_positive_rate", "reproduction_success_rate",
        "discovery_actions", "wall_time_seconds", "user_tasks_completed",
        "user_tasks_total", "model", "model_calls", "token_budget",
        "estimated_model_cost", "reproduction_actions",
        "total_actions_including_reproduction", "actions_per_valid_defect",
        "seconds_per_valid_defect", "detected_defect_types",
        "exclusive_defect_types"
      ]
    }
  }
}
