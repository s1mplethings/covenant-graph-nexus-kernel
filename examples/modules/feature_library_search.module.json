{
  "kind": "ModuleContract",
  "id": "module.feature.library_search",
  "version": "1",
  "ports": {
    "input": {
      "request": {
        "artifact_type": "artifact.customer_request@1",
        "required": true
      },
      "local_index": {
        "artifact_type": "artifact.local_library_index@1",
        "required": true
      },
      "online_sources": {
        "artifact_type": "artifact.online_library_sources@1",
        "required": false
      }
    },
    "output": {
      "candidates": {
        "artifact_type": "artifact.feature_library_candidates@1",
        "description": "Ranked local and online library candidates for the requested project capabilities."
      }
    }
  },
  "requires": {
    "capabilities": [],
    "context": ["run_id", "ranking_policy"]
  },
  "effects": {
    "fs_read": [],
    "fs_write": [],
    "network": false,
    "provider_call": false,
    "risk": 1
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "subset_or_equal"
  },
  "metadata": {
    "purpose": "Find capability libraries without coupling the caller to local or online source mechanics."
  }
}
