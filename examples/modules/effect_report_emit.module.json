{
  "kind": "ModuleContract",
  "id": "module.effect_report.emit",
  "version": "1",
  "ports": {
    "input": {
      "project_blueprint": {
        "artifact_type": "artifact.project_blueprint@1",
        "required": true
      },
      "generation_trace": {
        "artifact_type": "artifact.generation_trace@1",
        "required": true
      },
      "test_graph": {
        "artifact_type": "artifact.test_graph@1",
        "required": true
      }
    },
    "output": {
      "effect_report": {
        "artifact_type": "artifact.effect_report@1",
        "description": "Effect report covering generated outputs, checks, and risk notes."
      }
    }
  },
  "requires": {
    "capabilities": [],
    "context": ["run_id", "effect_policy"]
  },
  "effects": {
    "fs_read": [],
    "fs_write": [],
    "network": false,
    "provider_call": false,
    "risk": 1
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "subset_or_equal"
  },
  "metadata": {
    "purpose": "Emit the final effect report as a separate verification artifact."
  }
}
