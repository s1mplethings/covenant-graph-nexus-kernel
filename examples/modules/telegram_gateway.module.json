{
  "kind": "ModuleContract",
  "id": "module.telegram.gateway",
  "version": "1",
  "ports": {
    "input": {
      "message": {
        "artifact_type": "artifact.telegram_message@1",
        "required": true,
        "description": "Telegram message request with chat id, text, and optional attachments."
      }
    },
    "output": {
      "delivery_status": {
        "artifact_type": "artifact.telegram_delivery_status@1",
        "description": "Telegram delivery result with customer-visible status only."
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.network.telegram_bot_api",
        "scope": ["getMe", "getUpdates", "sendMessage", "sendDocument", "sendPhoto"]
      }
    ],
    "context": ["run_id", "telegram_token_source", "secret_redaction"]
  },
  "effects": {
    "fs_read": [],
    "fs_write": [],
    "network": true,
    "provider_call": false,
    "risk": 2
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "policy_bounded"
  },
  "metadata": {
    "purpose": "Generic Telegram gateway contract for live bot API transport."
  }
}
