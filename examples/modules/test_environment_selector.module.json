{
  "kind": "ModuleContract",
  "id": "module.test.environment_selector",
  "version": "1",
  "ports": {
    "input": {
      "goal": {
        "artifact_type": "artifact.goal@1",
        "required": true,
        "description": "Testing target and user intent."
      }
    },
    "output": {
      "environment_plan": {
        "artifact_type": "artifact.test_environment_plan@1",
        "description": "Candidate environments that can host the test run."
      }
    }
  },
  "requires": {
    "capabilities": [
      {
        "id": "cap.fs.read",
        "scope": ["examples/**", "generated/**", "scripts/**", "README.md"]
      }
    ],
    "context": ["workspace_root", "target_project_dir", "external_approval_flags"]
  },
  "effects": {
    "fs_read": ["examples/**", "generated/**", "scripts/**", "README.md"],
    "fs_write": [],
    "network": false,
    "provider_call": false,
    "risk": 1
  },
  "compatibility": {
    "replaceable": true,
    "movable": true,
    "surface_rule": "same_or_compatible",
    "effect_rule": "subset_or_equal"
  },
  "metadata": {
    "purpose": "Select test environments independently from test methods so agents can build a matrix instead of a fixed test script.",
    "environment_kinds": ["contract_catalog", "module_smoke", "local_runtime_artifacts", "generated_static_browser", "local_browser_runtime", "industrial_io_fixtures", "connectivity_dry_probe", "live_external_optional"]
  }
}
