    {"from": {"node": "n_feature_library_search", "port": "candidates"}, "to": {"node": "n_adversarial_generation", "port": "candidates"}},
    {"from": {"node": "n_feature_library_search", "port": "candidates"}, "to": {"node": "n_project_generator", "port": "candidates"}},
    {"from": {"node": "n_feature_library_search", "port": "candidates"}, "to": {"node": "n_unified_control", "port": "candidates"}},
    {"from": {"node": "n_local_agent", "port": "agent_plan"}, "to": {"node": "n_adversarial_generation", "port": "agent_plan"}},
    {"from": {"node": "n_local_agent", "port": "agent_plan"}, "to": {"node": "n_project_generator", "port": "agent_plan"}},
    {"from": {"node": "n_local_agent", "port": "agent_plan"}, "to": {"node": "n_unified_control", "port": "agent_plan"}},
    {"from": {"node": "n_adversarial_generation", "port": "adversarial_review"}, "to": {"node": "n_project_generator", "port": "adversarial_review"}},
    {"from": {"node": "n_adversarial_generation", "port": "adversarial_review"}, "to": {"node": "n_unified_control", "port": "adversarial_review"}},
    {"from": {"node": "n_project_generator", "port": "project_blueprint"}, "to": {"node": "n_test_graph_emit", "port": "project_blueprint"}},
    {"from": {"node": "n_project_generator", "port": "project_blueprint"}, "to": {"node": "n_effect_report_emit", "port": "project_blueprint"}},
    {"from": {"node": "n_project_generator", "port": "project_blueprint"}, "to": {"node": "n_unified_control", "port": "project_blueprint"}},
    {"from": {"node": "n_project_generator", "port": "generation_trace"}, "to": {"node": "n_test_graph_emit", "port": "generation_trace"}},
    {"from": {"node": "n_project_generator", "port": "generation_trace"}, "to": {"node": "n_effect_report_emit", "port": "generation_trace"}},
    {"from": {"node": "n_project_generator", "port": "generation_trace"}, "to": {"node": "n_unified_control", "port": "generation_trace"}},
    {"from": {"node": "n_test_graph_emit", "port": "test_graph"}, "to": {"node": "n_effect_report_emit", "port": "test_graph"}},
    {"from": {"node": "n_test_graph_emit", "port": "test_graph"}, "to": {"node": "n_unified_control", "port": "test_graph"}},
    {"from": {"node": "n_effect_report_emit", "port": "effect_report"}, "to": {"node": "n_unified_control", "port": "effect_report"}},
    {"from": {"node": "n_project_generator", "port": "generation_trace"}, "to": {"node": "n_generation_checkpoint_commit", "port": "generation_trace"}},
    {"from": {"node": "n_project_generator", "port": "project_blueprint"}, "to": {"node": "n_generation_checkpoint_commit", "port": "project_blueprint"}},
    {"from": {"node": "n_effect_report_emit", "port": "effect_report"}, "to": {"node": "n_generation_checkpoint_commit", "port": "effect_report"}},
    {"from": {"node": "n_generation_checkpoint_commit", "port": "checkpoint"}, "to": {"node": "n_context_pack_build", "port": "checkpoint"}},
    {"from": {"node": "n_conversation_reduce", "port": "state"}, "to": {"node": "n_context_pack_build", "port": "state"}},
    {"from": {"node": "n_local_agent", "port": "agent_plan"}, "to": {"node": "n_context_pack_build", "port": "agent_plan"}},
    {"from": {"node": "n_conversation_reduce", "port": "state"}, "to": {"node": "n_unified_control", "port": "conversation_state"}},
    {"from": {"node": "n_conversation_reduce", "port": "decision_ledger"}, "to": {"node": "n_unified_control", "port": "decision_ledger"}},
    {"from": {"node": "n_generation_checkpoint_commit", "port": "checkpoint"}, "to": {"node": "n_unified_control", "port": "generation_checkpoint"}},
    {"from": {"node": "n_context_pack_build", "port": "context_pack"}, "to": {"node": "n_unified_control", "port": "context_pack"}},
    {"from": {"node": "n_unified_control", "port": "project_blueprint"}, "to": {"flow_output": "project_blueprint"}},
    {"from": {"node": "n_unified_control", "port": "generation_trace"}, "to": {"flow_output": "generation_trace"}},
    {"from": {"node": "n_unified_control", "port": "test_graph"}, "to": {"flow_output": "test_graph"}},
    {"from": {"node": "n_unified_control", "port": "effect_report"}, "to": {"flow_output": "effect_report"}},
    {"from": {"node": "n_unified_control", "port": "conversation_state"}, "to": {"flow_output": "conversation_state"}},
    {"from": {"node": "n_unified_control", "port": "decision_ledger"}, "to": {"flow_output": "decision_ledger"}},
    {"from": {"node": "n_unified_control", "port": "generation_checkpoint"}, "to": {"flow_output": "generation_checkpoint"}},
    {"from": {"node": "n_unified_control", "port": "context_pack"}, "to": {"flow_output": "context_pack"}}
