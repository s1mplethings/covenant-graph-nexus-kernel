    {"from": {"node": "n_customer_service", "port": "request"}, "to": {"node": "n_local_agent", "port": "request"}},
    {"from": {"node": "n_customer_service", "port": "request"}, "to": {"node": "n_adversarial_generation", "port": "request"}},
    {"from": {"node": "n_customer_service", "port": "request"}, "to": {"node": "n_project_generator", "port": "request"}},
    {"from": {"node": "n_customer_service", "port": "request"}, "to": {"node": "n_unified_control", "port": "request"}},
