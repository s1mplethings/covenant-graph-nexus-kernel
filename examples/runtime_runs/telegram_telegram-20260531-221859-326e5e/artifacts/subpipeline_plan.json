{
  "kind": "PipelineOfPipelinesPlan",
  "payload": {
    "goal": "以下是用户主导的模拟 Telegram 项目需求对话记录。\n请只根据这份对话提取最终项目需求；不要自动套用 CRUD、任务看板、JSON 记录管理等默认模板；如果对话中要求真实项目/API测试，则保留该要求。运行时输入、输出和中间产物必须来自对话语义。\n\n[observer/decision] API 已连接。\n[customer/message] 你好\n[service/message] 你好！请问有什么我可以帮助你的吗？\n[customer/message] 我想要做一个帮我在游戏视频找高光片段的项目\n[service/message] 我先按“游戏视频找高光片段”理解，输入是游戏视频文件，输出是多个 MP4 高光片段。高光的判断标准可以按默认的综合判断吗，还是你有指定的事件？\n[customer/message] 输入时所有的视频都可以，然后输出就是mp4，高光就是一个一个视频的形式\n[service/message] 我理解了，输入是所有类型的游戏视频文件，输出是多个 MP4 格式的高光片段，每个高光片段都是一个单独的视频。信息足够，可以生成项目。\n[observer/criterion] 检测到对话里的生成意图，开始用当前对话生成项目并执行测试。",
    "control": "module.unified_control@1",
    "selected_modules": [
      "module.customer.service@1",
      "module.requirement_blueprint.generator@1",
      "module.local.librarian@1",
      "module.online.library_sources@1",
      "module.feature.library_search@1",
      "module.local_agent.plan@1",
      "module.adversarial_generation@1",
      "module.project.generator@1",
      "module.test_graph.emit@1",
      "module.effect_report.emit@1",
      "module.unified_control@1"
    ],
    "routing_policy": {
      "local_model_scope": [
        "local_librarian",
        "route_manager"
      ],
      "provider_scope": [
        "project_architecture",
        "project_generation",
        "project_repair",
        "final_project_logic",
        "adversarial_review"
      ]
    },
    "pipelines": [
      {
        "id": "customer_intake_pipeline",
        "kind": "intake",
        "input": [
          "goal"
        ],
        "output": [
          "structured_request",
          "clarifying_questions"
        ],
        "owner": "module.customer.service@1"
      },
      {
        "id": "requirement_blueprint_pipeline",
        "kind": "requirement_to_blueprint",
        "input": [
          "structured_request",
          "clarifying_questions"
        ],
        "output": [
          "requirement_spec",
          "io_contract",
          "gap_analysis",
          "feature_spec",
          "capability_map",
          "tech_candidates",
          "tech_decisions",
          "architecture.mmd",
          "api.openapi.yaml",
          "db_schema.sql",
          "frontend_pages.json",
          "task_backlog.csv",
          "prd.md"
        ],
        "owner": "module.requirement_blueprint.generator@1",
        "agents": [
          "RequirementAgent",
          "IOContractAgent",
          "GapAgent",
          "FeatureAgent",
          "CapabilityAgent",
          "TechSearchAgent",
          "TechDecisionAgent",
          "BlueprintAgent",
          "TaskAgent",
          "ReviewAgent"
        ],
        "priority": "blocks_project_generation_until_level_3_gaps_are_resolved_or_defaulted"
      },
      {
        "id": "local_librarian_pipeline",
        "kind": "local_understanding",
        "input": [
          "structured_request",
          "requirement_spec",
          "io_contract",
          "capability_map",
          "local_contract_catalog"
        ],
        "output": [
          "local_index",
          "capability_candidates"
        ],
        "owner": "module.local.librarian@1",
        "model": ""
      },
      {
        "id": "route_manager_pipeline",
        "kind": "local_route_management",
        "input": [
          "local_index",
          "capability_candidates",
          "structured_request"
        ],
        "output": [
          "subpipeline_plan",
          "routing_policy"
        ],
        "owner": "module.local.pipeline_composer_agent@1",
        "model": ""
      },
      {
        "id": "user_analysis_pipeline",
        "kind": "product_strategy",
        "input": [
          "structured_request",
          "local_index"
        ],
        "output": [
          "docs/USER_ANALYSIS.md",
          "user_analysis"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "market_research_pipeline",
        "kind": "market_research",
        "input": [
          "structured_request",
          "user_analysis"
        ],
        "output": [
          "docs/MARKET_RESEARCH.md",
          "market_positioning"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "technical_path_pipeline",
        "kind": "technical_path_selection",
        "input": [
          "structured_request",
          "market_positioning",
          "local_capabilities"
        ],
        "output": [
          "docs/TECHNICAL_PATH.md",
          "technical_path"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "ux_design_pipeline",
        "kind": "ux_design",
        "input": [
          "user_analysis",
          "market_positioning",
          "technical_path"
        ],
        "output": [
          "docs/UX_DESIGN_SPEC.md",
          "ui_structure_contract"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "industrial_io_pipeline",
        "kind": "industrial_input_output_simulation",
        "input": [
          "structured_request",
          "user_analysis",
          "market_positioning",
          "technical_path",
          "ui_structure_contract"
        ],
        "output": [
          "docs/INPUT_OUTPUT_SPEC.md",
          "data/industrial_input_bundle.json",
          "data/expected_outputs.json",
          "tests/industrial_io_smoke_test.js"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "product_decision_gate_pipeline",
        "kind": "product_scope_decision",
        "input": [
          "user_analysis",
          "market_positioning",
          "technical_path",
          "ui_structure_contract",
          "industrial_io_contract"
        ],
        "output": [
          "docs/PRODUCT_DECISION_LOG.md",
          "current_capabilities",
          "out_of_scope_current_capabilities"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "blocks_code_generation_until_current_scope_is_truthful"
      },
      {
        "id": "project_architecture_pipeline",
        "kind": "provider_design",
        "input": [
          "structured_request",
          "subpipeline_plan",
          "user_analysis",
          "market_positioning",
          "technical_path",
          "ui_structure_contract",
          "industrial_io_contract",
          "current_capabilities",
          "out_of_scope_current_capabilities",
          "module_contracts"
        ],
        "output": [
          "project_architecture.json"
        ],
        "owner": "module.external.api_gateway@1"
      },
      {
        "id": "integration_pipeline",
        "kind": "integration",
        "input": [
          "module_outputs"
        ],
        "output": [
          "integrated_project_files"
        ],
        "owner": "module.local.runtime_executor@1"
      },
      {
        "id": "self_test_pipeline",
        "kind": "self_test",
        "input": [
          "integrated_project_files"
        ],
        "output": [
          "self_test_report"
        ],
        "owner": "module.local.runtime_executor@1"
      },
      {
        "id": "quality_evaluation_pipeline",
        "kind": "quality_eval",
        "input": [
          "integrated_project_files",
          "self_test_report"
        ],
        "output": [
          "quality_report"
        ],
        "owner": "module.local.runtime_executor@1"
      },
      {
        "id": "adversarial_review_pipeline",
        "kind": "adversarial_review",
        "input": [
          "integrated_project_files",
          "quality_report"
        ],
        "output": [
          "adversarial_review"
        ],
        "owner": "module.external.api_gateway@1"
      },
      {
        "id": "repair_pipeline",
        "kind": "provider_repair",
        "input": [
          "adversarial_review",
          "quality_report"
        ],
        "output": [
          "repaired_project_files"
        ],
        "owner": "module.external.api_gateway@1",
        "activation": "only when quality gate fails or adversarial review reports blocking issues"
      },
      {
        "id": "effect_report_pipeline",
        "kind": "reporting",
        "input": [
          "self_test_report",
          "quality_report",
          "adversarial_review",
          "project_blueprint"
        ],
        "output": [
          "test_graph",
          "effect_report"
        ],
        "owner": "module.effect_report.emit@1"
      }
    ]
  }
}
