{
  "kind": "PipelineOfPipelinesPlan",
  "payload": {
    "goal": "我想要一个可以给我找出游戏主播高光时刻的完整项目。必须先做用户分析、市场调研、技术路径选择、UX设计和产品决策门，然后生成项目。现在重点是它要可以直接模拟类似工业输入，不论资源是从平台事件日志、聊天分析、公开视频元数据、人工标注、运营审核还是其他资源来的，都要组织成具体可导入的工业输入 bundle，并提供明确的 expected outputs。项目要有清晰GUI，可以导入工业输入bundle，自动评分排序，筛选主播、游戏、分类和分数，添加人工标记，导出剪辑清单，提供样例数据、工业输入输出说明、模块化源码、浏览器测试脚本、工业I/O测试脚本、架构说明和测试效果报告。不要把没有实现的拖拽、时间线、协作、CV、NLP、机器学习、后端、数据库写成当前功能。\n生成要求：输出真实项目文件、项目蓝图、生成过程、测试图、效果报告和 runtime_result。",
    "control": "module.unified_control@1",
    "selected_modules": [
      "module.customer.service@1",
      "module.feature.library_search@1",
      "module.local.librarian@1",
      "module.project.generator@1",
      "module.local.runtime_executor@1",
      "module.local.pipeline_composer_agent@1",
      "module.local_agent.plan@1",
      "module.test_graph.emit@1",
      "module.effect_report.emit@1",
      "module.unified_control@1",
      "module.external.api_gateway@1"
    ],
    "routing_policy": {
      "local_model_scope": [
        "local_librarian",
        "route_manager"
      ],
      "provider_scope": [
        "project_architecture",
        "project_generation",
        "project_repair",
        "final_project_logic",
        "adversarial_review"
      ]
    },
    "pipelines": [
      {
        "id": "customer_intake_pipeline",
        "kind": "intake",
        "input": [
          "goal"
        ],
        "output": [
          "structured_request",
          "clarifying_questions"
        ],
        "owner": "module.customer.service@1"
      },
      {
        "id": "local_librarian_pipeline",
        "kind": "local_understanding",
        "input": [
          "structured_request",
          "local_contract_catalog"
        ],
        "output": [
          "local_index",
          "capability_candidates"
        ],
        "owner": "module.local.librarian@1",
        "model": "qwen2.5:7b-instruct"
      },
      {
        "id": "route_manager_pipeline",
        "kind": "local_route_management",
        "input": [
          "local_index",
          "capability_candidates",
          "structured_request"
        ],
        "output": [
          "subpipeline_plan",
          "routing_policy"
        ],
        "owner": "module.local.pipeline_composer_agent@1",
        "model": "qwen2.5:7b-instruct"
      },
      {
        "id": "user_analysis_pipeline",
        "kind": "product_strategy",
        "input": [
          "structured_request",
          "local_index"
        ],
        "output": [
          "docs/USER_ANALYSIS.md",
          "user_analysis"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "market_research_pipeline",
        "kind": "market_research",
        "input": [
          "structured_request",
          "user_analysis"
        ],
        "output": [
          "docs/MARKET_RESEARCH.md",
          "market_positioning"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "technical_path_pipeline",
        "kind": "technical_path_selection",
        "input": [
          "structured_request",
          "market_positioning",
          "local_capabilities"
        ],
        "output": [
          "docs/TECHNICAL_PATH.md",
          "technical_path"
        ],
        "owner": "module.external.api_gateway@1",
        "priority": "higher_than_code_generation"
      },
      {
        "id": "ux_design_pipeline",
        "kind": "ux_design",
