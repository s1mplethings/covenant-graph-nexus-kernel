        ],
        "owner": "module.external.api_gateway@1",
        "local_model_scope": [],
        "provider_scope": [
          "project_generation",
          "final_project_logic"
        ]
      },
      {
        "id": "data_import_pipeline::src/core/importer.js",
        "kind": "module_pipeline",
        "input": [
          "project_architecture",
          "module_contract",
          "dom_contract"
        ],
        "output": [
          "src/core/importer.js"
        ],
        "owner": "module.external.api_gateway@1",
        "local_model_scope": [],
        "provider_scope": [
          "project_generation",
          "final_project_logic"
        ]
      },
      {
        "id": "storage_export_pipeline::src/core/exporter.js",
        "kind": "module_pipeline",
        "input": [
          "project_architecture",
          "module_contract",
          "dom_contract"
        ],
        "output": [
          "src/core/exporter.js"
        ],
        "owner": "module.external.api_gateway@1",
        "local_model_scope": [],
        "provider_scope": [
          "project_generation",
