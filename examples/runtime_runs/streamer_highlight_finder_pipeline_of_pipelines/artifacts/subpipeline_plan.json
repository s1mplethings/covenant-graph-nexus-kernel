          "dom_contract"
        ],
        "output": [
          "src/state/store.js"
        ],
        "owner": "module.external.api_gateway@1",
        "local_model_scope": [],
        "provider_scope": [
          "project_generation",
          "final_project_logic"
        ]
      },
      {
        "id": "ui_integration_pipeline::src/ui/render.js",
        "kind": "module_pipeline",
        "input": [
