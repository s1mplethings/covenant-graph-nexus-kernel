{
  "kind": "PipelineOfPipelinesPlan",
  "payload": {
    "goal": "我想要一个可以给我找出游戏主播的高光时刻的完整项目，可以导入直播事件数据，自动评分和排序，筛选主播、游戏、分类和分数，添加人工标记，导出剪辑清单，提供样例数据、模块化源码、测试脚本、架构说明，并输出测试效果报告\n客服澄清信息：\n- target_user: 目标用户为游戏主播、内容剪辑和直播运营人员。\n- data_storage: 默认使用浏览器本地存储，后续可升级为文件或数据库。\n生成要求：输出真实项目文件、项目蓝图、生成过程、测试图、效果报告和 runtime_result。",
    "control": "module.unified_control@1",
    "selected_modules": [
      "module.feature.library_search@1",
      "module.local.librarian@1",
      "module.project.generator@1",
      "module.local.runtime_executor@1",
      "module.local.pipeline_composer_agent@1",
      "module.customer.service@1",
      "module.local_agent.plan@1",
      "module.test_graph.emit@1",
      "module.effect_report.emit@1",
      "module.unified_control@1",
      "module.external.api_gateway@1"
    ],
    "routing_policy": {
      "local_model_scope": [
        "local_librarian",
        "route_manager"
      ],
      "provider_scope": [
        "project_architecture",
        "project_generation",
        "project_repair",
        "final_project_logic",
        "adversarial_review"
      ]
    },
    "pipelines": [
      {
        "id": "customer_intake_pipeline",
        "kind": "intake",
        "input": [
          "goal"
        ],
        "output": [
          "structured_request",
          "clarifying_questions"
        ],
        "owner": "module.customer.service@1"
      },
      {
        "id": "local_librarian_pipeline",
        "kind": "local_understanding",
        "input": [
          "structured_request",
          "local_contract_catalog"
        ],
        "output": [
          "local_index",
          "capability_candidates"
        ],
        "owner": "module.local.librarian@1",
        "model": "qwen2.5:7b-instruct"
      },
      {
        "id": "route_manager_pipeline",
        "kind": "local_route_management",
        "input": [
          "local_index",
          "capability_candidates",
          "structured_request"
        ],
        "output": [
          "subpipeline_plan",
          "routing_policy"
        ],
        "owner": "module.local.pipeline_composer_agent@1",
        "model": "qwen2.5:7b-instruct"
      },
      {
        "id": "project_architecture_pipeline",
        "kind": "provider_design",
        "input": [
          "structured_request",
          "subpipeline_plan",
          "module_contracts"
        ],
        "output": [
          "project_architecture.json"
        ],
        "owner": "module.external.api_gateway@1"
      },
      {
        "id": "scoring_pipeline::src/core/scoring.js",
        "kind": "module_pipeline",
        "input": [
          "project_architecture",
          "module_contract",
          "dom_contract"
        ],
        "output": [
          "src/core/scoring.js"
        ],
        "owner": "module.external.api_gateway@1",
        "local_model_scope": [],
        "provider_scope": [
          "project_generation",
          "final_project_logic"
        ]
      },
      {
        "id": "filtering_pipeline::src/core/filtering.js",
        "kind": "module_pipeline",
        "input": [
          "project_architecture",
          "module_contract",
          "dom_contract"
        ],
        "output": [
