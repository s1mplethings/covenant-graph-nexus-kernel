{
  "kind": "PolicySpec",
  "id": "policy.safe_modular_project_generation",
  "version": "1",
  "fs": {
    "allowed_read": ["libraries/**", "examples/modules/**", "examples/artifacts/**", "examples/flows/**", "schemas/**", "generated/**"],
    "allowed_write": ["generated/**", "examples/test_results/**", "examples/runtime_runs/**"],
    "denied_write": [".git/**", ".env", "secrets/**", "*.pem", "*.key"]
  },
  "network": {
    "allowed": true
  },
  "provider": {
    "allowed": false
  },
  "risk": {
    "max_risk": 2
  },
  "agent_permissions": {
    "allowed_edits": ["add_node", "replace_node", "connect", "disconnect", "split_edge", "add_gate", "upgrade_module_version"],
    "denied_edits": ["weaken_policy", "change_artifact_schema", "change_policy_ref", "remove_gate"],
    "requires_human_review": ["remove_node", "upgrade_major_version"]
  }
}
