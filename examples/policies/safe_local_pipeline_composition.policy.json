{
  "kind": "PolicySpec",
  "id": "policy.safe_local_pipeline_composition",
  "version": "1",
  "fs": {
    "allowed_read": [
      "examples/modules/**",
      "examples/artifacts/**",
      "examples/flows/**",
      "examples/policies/**",
      "schemas/**",
      "implementation_plan/**",
      "README.md"
    ],
    "allowed_write": [
      "examples/test_results/**",
      "examples/runtime_runs/**"
    ],
    "denied_write": [
      ".git/**",
      ".env",
      "secrets/**",
      "*.pem",
      "*.key"
    ]
  },
  "network": {
    "allowed": false
  },
  "provider": {
    "allowed": false
  },
  "risk": {
    "max_risk": 1
  },
  "agent_permissions": {
    "allowed_edits": ["add_node", "connect", "add_gate"],
    "denied_edits": ["weaken_policy", "change_artifact_schema", "change_policy_ref", "remove_gate"],
    "requires_human_review": ["remove_node", "upgrade_major_version", "enable_network", "enable_provider"]
  }
}
