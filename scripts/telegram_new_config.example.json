{
  "state_dir": "generated/telegram_new_listener",
  "archive_dir": "generated/telegram_new_archives",
  "history_mode": "archive",
  "history_globs": [
    "examples/runtime_runs/**/artifacts/conversation_state.json",
    "examples/runtime_runs/**/artifacts/decision_ledger.json",
    "examples/runtime_runs/**/artifacts/generation_checkpoint.json",
    "examples/runtime_runs/**/artifacts/context_pack.json",
    "examples/runtime_runs/**/artifacts/conversation_turn_index.json",
    "examples/runtime_runs/**/artifacts/conversation_turns/*.json",
    "generated/**/conversation_state.json",
    "generated/**/decision_ledger.json",
    "generated/**/generation_checkpoint.json",
    "generated/**/context_pack.json",
    "generated/**/test_result.json",
    "generated/**/test-run/*.json"
  ],
  "processes": [
    {
      "name": "frontend",
      "cwd": "generated/prompt-quality-check",
      "start_command": ["python", "-m", "http.server", "8000", "--bind", "127.0.0.1"],
      "pid_file": "generated/telegram_new_listener/frontend.pid",
      "stdout_log": "generated/telegram_new_listener/frontend.out.log",
      "stderr_log": "generated/telegram_new_listener/frontend.err.log",
      "stop_ports": [8000],
      "restart": true
    },
    {
      "name": "backend",
      "cwd": ".",
      "start_command": [],
      "pid_file": "generated/telegram_new_listener/backend.pid",
      "stdout_log": "generated/telegram_new_listener/backend.out.log",
      "stderr_log": "generated/telegram_new_listener/backend.err.log",
      "stop_ports": [],
      "restart": false
    }
  ]
}
