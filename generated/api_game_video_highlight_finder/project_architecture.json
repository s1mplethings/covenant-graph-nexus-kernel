  "test_strategy": [
    "Browser smoke tests to ensure basic functionality.",
    "Industrial I/O smoke tests to validate input and output contracts."
  ],
  "acceptance_criteria": [
    "Generated project must run locally from index.html under python -m http.server.",
    "Provide visible filter controls and executable filter logic for the requested fields.",
    "Persist working data locally with localStorage and reload it on page load.",
    "Use domain fields such as streamer, game, timestamp/time, category, intensity, chatRate, keywords, title, description, and score.",
    "The project runs as a local static browser app from index.html.",
    "The GUI imports both sample JSON arrays and full industrial input bundle objects.",
    "The app scores, sorts, filters, manually appends, persists, and exports highlight candidates using implemented modules.",
    "Browser smoke tests and industrial I/O smoke tests validate the real generated UI."
  ]
}