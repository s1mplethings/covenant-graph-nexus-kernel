{
  "product_context": {
    "key_features": [
      "Local static browser app",
      "Textarea/file JSON import",
      "Industrial bundle import",
      "Scoring/sorting",
      "Streamer/game/category/min-score filters",
      "Manual marker",
      "Blob JSON export",
      "LocalStorage persistence",
      "Browser smoke test",
      "Industrial I/O smoke test"
    ]
  },
  "screens": [
    "data_import_screen",
    "filter_and_sort_screen",
    "ranked_results_screen",
    "manual_marker_screen",
    "export_screen"
  ],
  "modules": [
    {
      "path": "src/core/scoring.js",
      "responsibility": "Handles scoring and sorting of highlight records.",
      "exports": [
        "scoreRecord",
        "sortRecords"
      ],
      "imports": []
    },
    {
      "path": "src/core/filtering.js",
      "responsibility": "Applies filters to highlight records.",
      "exports": [
        "applyFilters"
      ],
      "imports": []
    },
    {
      "path": "src/core/importer.js",
      "responsibility": "Imports highlight records from JSON.",
      "exports": [
        "parseRecordsFromText",
        "normalizeRecord",
        "importData"
      ],
      "imports": []
    },
    {
      "path": "src/core/exporter.js",
      "responsibility": "Exports highlight records to JSON.",
      "exports": [
        "downloadJson",
        "exportData"
      ],
      "imports": []
    },
    {
      "path": "src/state/store.js",
      "responsibility": "Manages localStorage for highlight records.",
      "exports": [
        "loadRecords",
        "saveRecords",
        "clearRecords",
        "loadFromLocalStorage",
        "saveToLocalStorage"
      ],
      "imports": []
    },
    {
      "path": "src/ui/render.js",
      "responsibility": "Renders UI components for displaying highlights.",
      "exports": [
        "renderRecords",
        "renderSummary",
        "renderError"
      ],
      "imports": []
    },
    {
      "path": "src/ui/forms.js",
      "responsibility": "Handles user input forms for filters and manual markers.",
      "exports": [
        "readFilters",
        "readManualMarker",
        "bindDom",
        "setupForms"
      ],
      "imports": []
    },
    {
      "path": "src/app.js",
      "responsibility": "Main application logic and initialization.",
      "exports": [],
      "imports": []
    }
  ],
  "data_contract": {
    "record_fields": [
      "sourceId",
      "streamer",
      "game",
      "category",
      "timestamp",
      "time",
      "title",
      "description",
      "intensity",
      "chatRate",
      "keywords",
      "viewerSpike",
      "clipSignal"
    ],
    "sample_shape": {}
  },
  "industrial_io_contract": {
    "input_bundle_path": "data/industrial_input_bundle.json",
    "expected_outputs_path": "data/expected_outputs.json",
    "documentation_path": "docs/INPUT_OUTPUT_SPEC.md",
    "test_path": "tests/industrial_io_smoke_test.js",
    "source_manifest_fields": [
      "source_id",
      "source_type",
      "origin",
      "trust_level",
      "license_or_access",
      "fields_provided"
    ],
    "minimum_record_count": 20,
    "output_contract": [
      "ranked_highlights",
      "export_cut_list",
      "quality_checks",
      "input_summary"
    ]
  },
  "ux_contract": {
    "required_classes": [
      "app-shell",
      "app-header",
      "workspace-grid",
      "intake-panel",
      "filters-panel",
      "results-panel",
      "manual-panel",
      "status-strip",
