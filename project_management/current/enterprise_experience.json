  "items": [
    {
      "id": "EXP-CGKN-QUALITY-001",
      "title": "Separate planning, implementation, and delivery truth",
      "situation": "Planning artifacts or generated files exist while canonical runtime, review, package, or delivery evidence may be incomplete.",
      "action": "Evaluate each evidence layer independently and allow only canonical producers and inspectors to authorize formal gates.",
      "outcome": "Progress remains visible without a false public delivery PASS.",
      "applicable_when": [
        "CGKN planning, implementation, acceptance, and delivery work"
      ],
      "not_applicable_when": [],
      "tags": [
        "cgkn",
        "quality",
        "evidence",
        "governance"
      ],
      "evidence_refs": [
        "docs/01_contract_registry.md",
        "tests/test_kernel_contract.py"
      ],
      "experience_state": "approved",
      "usage_count": 54,
      "successful_usage_count": 53,
      "owner": "quality-management",
      "supersedes": []
    },
    {
      "id": "EXP-CGKN-LIBRARIAN-001",
      "title": "Use bounded artifact projections instead of whole-history context",
      "situation": "A project has enough files or upstream evidence that copying complete context is noisy and expensive.",
      "action": "Keep complete local lineage and provide each bounded module only its declared artifacts, projections, policy, and contract.",
      "outcome": "Context remains traceable and unaffected checkpoints remain reusable.",
      "applicable_when": [
        "Artifact-driven modules",
        "large Provider jobs",
        "incremental repair"
      ],
      "not_applicable_when": [
        "A tiny single-file change where the projection exceeds the source"
      ],
      "tags": [
        "cgkn",
        "artifact",
        "context",
        "librarian"
      ],
      "evidence_refs": [
        "docs/00_kernel_contract.md",
        "evidence/artifact-kernel/v0.3/verification_summary.json"
      ],
      "experience_state": "approved",
      "usage_count": 29,
      "successful_usage_count": 27,
      "owner": "context-librarian",
      "supersedes": []
    },
    {
      "id": "EXP-CGKN-REPO-001",
      "title": "Promote curated evidence instead of tracking raw runs",
      "situation": "Reproducible runtime output accumulates in Git and obscures source, specs, and durable claims.",
      "action": "Keep runs local and promote only claim, status, metrics, hashes, reproduction commands, and limitations.",
      "outcome": "HEAD stays reviewable while important claims remain reproducible.",
      "applicable_when": [
        "Repository evidence retention",
        "benchmark publication",
        "release summaries"
      ],
      "not_applicable_when": [
        "Canonical runtime storage during an active local run"
      ],
      "tags": [
        "cgkn",
        "repository",
        "evidence",
        "hygiene"
      ],
      "evidence_refs": [
        "docs/repository_guide.md",
        "scripts/promote_evidence.py"
      ],
      "experience_state": "approved",
      "usage_count": 3,
      "successful_usage_count": 3,
      "owner": "repository-maintenance",
      "supersedes": []
    }
  ],
